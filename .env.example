# 复制这个文件为 .env 再填写。.env 已被 .gitignore 忽略，不会进入仓库，
# 也不会出现在接口响应或浏览器里。
#
# 服务启动时会自动读取项目根目录的 .env；已经存在的系统环境变量优先，
# 不会被这里的值覆盖。测试不会读取这个文件。

# 必填：DeepSeek 密钥
DEEPSEEK_API_KEY=

# 可选：默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=

# 可选：调试时打印服务端错误对象
# ZHIBIAN_DEBUG=1

# 可选：补充的知乎开放平台 Access Secret。主凭据某项接口返回额度或频率受限（30001）、
# 凭据无效（20001）时，同一请求自动改用它。主凭据可以放在 ZHIHU_ACCESS_SECRET，
# 也可以留空、沿用知乎 CLI 自己的系统凭据库。
# ZHIHU_ACCESS_SECRET_2=

# 可选：部署在反向代理后面时的公开域名，多个用逗号分隔（只写主机名，不带端口）。
# 本机 localhost / 127.0.0.1 始终允许访问。
# ZHIBIAN_PUBLIC_HOSTS=zhibian.example.com
